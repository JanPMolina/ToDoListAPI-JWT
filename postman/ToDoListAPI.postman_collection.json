{
  "info": {
    "name": "ToDoList API (JWT + Usuarios)",
    "description": "Tarea JWT + Usuarios — Diseño de Software (ITCR).\n\nAPI REST en Express 5 por capas + Supabase, documentada con Swagger (/api/docs) y protegida con JWT.\n\nOrden sugerido: ejecutar la colección completa con el Collection Runner. El request **Login** guarda el `accessToken` en la variable `token`, y **Crear tarea** guarda su id en `taskId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "email",
      "value": "ana@test.com"
    },
    {
      "key": "password",
      "value": "supersecreta"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
